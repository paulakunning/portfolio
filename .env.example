# Resend API key (https://resend.com/api-keys). Leave empty with CONTACT_DRY_RUN=true locally.
RESEND_API_KEY=
# Inbox that receives the contact form messages.
CONTACT_TO_EMAIL=paulakunning@gmail.com
# Verified sender. Use onboarding@resend.dev until paulakunning.com is verified in Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev
# true: log messages to the console instead of sending them (local development and E2E tests).
CONTACT_DRY_RUN=true
